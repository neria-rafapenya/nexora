backoffice.cuinora.com {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		X-Robots-Tag "noindex, nofollow"
	}
	handle /api/* {
		reverse_proxy 127.0.0.1:3000 {
			header_up Host 127.0.0.1:3000
		}
	}
	handle {
		root * /var/www/horekia/nexora-backoffice/dist
		try_files {path} /index.html
		header Cache-Control "no-cache"
		file_server
	}
}

http://cuinora.com, http://www.cuinora.com {
	redir https://www.cuinora.com{uri} 301
}

cuinora.com {
	redir https://www.cuinora.com{uri} 301
}

www.cuinora.com {
	encode zstd gzip
	root * /var/www/horekia/horekia-site/dist
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
	}
	@immutable path_regexp assets ^/assets/site-[a-f0-9]+\.(css|js)$
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	@legal path /contacto /contacto/* /privacidad /privacidad/* /aviso-legal /aviso-legal/* /cookies /cookies/*
	header @legal X-Robots-Tag "noindex, follow"
	@html path / /privacidad /privacidad/ /aviso-legal /aviso-legal/ /cookies /cookies/ /contacto /contacto/ /404.html
	header @html Cache-Control "no-cache"
	@contact path /api/public/contact /api/public/contact-token
	handle @contact {
		reverse_proxy 127.0.0.1:3000 {
			header_up Host 127.0.0.1:3000
			header_up -Cookie
		}
	}
	handle /api/* {
		respond 404
	}
	handle {
		file_server
	}
	handle_errors {
		rewrite * /404.html
		file_server
	}
}

app.cuinora.com {
	encode zstd gzip
	root * /var/www/horekia/horekia-app/dist
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		X-Robots-Tag "noindex, nofollow"
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000"
		Cache-Control "no-cache"
	}
	handle /api/client/* {
		reverse_proxy 127.0.0.1:3000 {
			header_up Host 127.0.0.1:3000
		}
	}
	handle /api/* {
		respond 404
	}
	@assets path /_expo/* /assets/*
	handle @assets {
		file_server
	}
	handle {
		try_files {path}.html {path} /index.html
		file_server
	}
}

horekia.com, www.horekia.com, backoffice.horekia.com {
	header X-Robots-Tag "noindex, nofollow"
	respond "Dominio reservado." 410
}
