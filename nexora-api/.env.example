DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres
PORT=5181
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
MFA_KEY=
# Enable only behind local HTTPS or a reverse proxy with HTTPS:
COOKIE_SECURE=false

# Local demo only; keep client simulation disabled outside an explicit demo.
ENABLE_MOCK_CLIENT=false
# Use mock in the local demo; no real ERP connector is configured.
ERP_PROVIDER=unconfigured

# Gemini POC: disabled by default. Server only; never use a VITE_ variable.
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# Operator attestation of a free-tier project; this is not an API billing check.
GEMINI_FREE_TIER_CONFIRMED=false
GEMINI_MAX_DAILY_REQUESTS=5
