DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres
PORT=5181
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
MFA_KEY=
# Enable only behind local HTTPS or a reverse proxy with HTTPS:
COOKIE_SECURE=false
# Public HTTPS origin in deployment; requests with other origins are rejected.
ALLOWED_ORIGINS=http://127.0.0.1:5180,http://localhost:5180,http://127.0.0.1:5181

# Local demo only; keep client simulation disabled outside an explicit demo.
ENABLE_MOCK_CLIENT=false
# Use mock in the local demo; no real ERP connector is configured.
ERP_PROVIDER=unconfigured

# Gemini POC: disabled by default. Server only; never use a VITE_ variable.
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Operator attestation of a free-tier project; this is not an API billing check.
GEMINI_FREE_TIER_CONFIRMED=false
GEMINI_MAX_DAILY_REQUESTS=5

# Semantic search: explicit POC requests only; separate local daily request cap.
GEMINI_EMBEDDINGS_ENABLED=false
GEMINI_EMBEDDING_MAX_DAILY_REQUESTS=50

# Private binary files on disk, outside the web root.
# Production: /var/lib/horekia/uploads
# UPLOADS_DIR=/var/lib/horekia/uploads

# Public website contact form (no email or AI calls).
CONTACT_FORM_ENABLED=false
CONTACT_SITE_ORIGIN=https://www.horekia.com
CONTACT_TENANT_ID=workspace
# Add https://www.horekia.com to ALLOWED_ORIGINS when enabling production.
