DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres
PORT=5181
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
MFA_KEY=
# Enable only behind local HTTPS or a reverse proxy with HTTPS:
COOKIE_SECURE=false

# Local demo only; keep client simulation disabled outside an explicit demo.
ENABLE_MOCK_CLIENT=false
# Use mock in the local demo; no real ERP connector is configured.
ERP_PROVIDER=unconfigured
