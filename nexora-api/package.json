{
  "name": "nexora-api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --env-file=.env src/server.mjs",
    "start": "node --env-file=.env src/server.mjs",
    "test": "node --test test/*.test.mjs",
    "db:verify": "node --env-file=.env src/verify.mjs",
    "test:integration": "node --env-file=.env --test test/integration.test.mjs",
    "db:seed-allergens": "node --env-file=.env src/seed-allergens.mjs",
    "db:seed-masters": "node --env-file=.env src/seed-masters.mjs",
    "db:seed-menu-details": "node --env-file=.env src/seed-menu-details.mjs",
    "db:seed-documents": "node --env-file=.env src/seed-documents.mjs",
    "db:seed-menus": "node --env-file=.env src/seed-menus.mjs",
    "db:seed-orders": "node --env-file=.env src/seed-orders.mjs"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "pdfjs-dist": "^6.5.438",
    "pg": "^8.16.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
